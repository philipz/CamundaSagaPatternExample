{
  "name": "camunda-saga-counterexample-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Executable tests for every counterexample in specs/quint/REPORT.md and specs/lean/REPORT.md (CE-1…CE-6, R1, ENV-1). Known violations are marked todo.",
  "scripts": {
    "test": "node --test --test-reporter=spec \"tests/*.test.mjs\"",
    "test:watch": "node --test --watch \"tests/*.test.mjs\"",
    "simulate": "node run-saga.mjs",
    "simulate:cancel": "node run-saga.mjs --cancel"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "bpmn-moddle": "10.3.1",
    "camunda-bpmn-moddle": "8.0.2",
    "camunda-external-task-client-js": "2.3.1"
  },
  "dependencies": {
    "@bpmnkit/engine": "^1.3.0"
  }
}
