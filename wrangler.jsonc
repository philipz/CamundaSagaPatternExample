{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wandersaga",
  "main": "src/index.js",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
